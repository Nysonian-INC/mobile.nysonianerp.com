{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "testflight"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6785603848"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6785603848"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
